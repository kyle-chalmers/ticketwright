{
  "name": "ticketwright",
  "displayName": "Ticketwright",
  "version": "4.7.2",
  "description": "Ticket-driven analysis in Claude Code: prior work recalled, every result re-run and signed off, and nothing posted without your go-ahead.",
  "author": {
    "name": "Kyle Chalmers",
    "url": "https://kclabs.ai"
  },
  "homepage": "https://github.com/kyle-chalmers/ticketwright",
  "repository": "https://github.com/kyle-chalmers/ticketwright",
  "license": "MIT",
  "keywords": [
    "analytics",
    "tickets",
    "data",
    "sql",
    "snowflake",
    "bigquery",
    "jira",
    "linear",
    "azure-devops",
    "qc",
    "workflow",
    "recall",
    "claude-code"
  ],
  "icon": "./.claude-plugin/icon.png",
  "documentationUrl": "https://github.com/kyle-chalmers/ticketwright/blob/main/docs/README.md",
  "supportUrl": "https://github.com/kyle-chalmers/ticketwright/blob/main/SUPPORT.md",
  "privacyPolicyUrl": "https://github.com/kyle-chalmers/ticketwright/blob/main/PRIVACY.md",
  "skills": "./.claude/skills/",
  "agents": [
    "./.claude/agents/qc-reviewer.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/db_write_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/source_material_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/review_verdict_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/regenerate_ticket_index.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/session_context.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/ticket_index_context.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
